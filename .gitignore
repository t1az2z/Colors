# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated by plugins / Unity
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/[Ss]treamingAssets/aa*
crashlytics-build.properties
sysinfo.txt

# Unity-generated IDE projects (regenerated by the editor)
/*.csproj
/*.sln
/*.slnx
/*.unityproj
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDEs
.vs/
.vscode/
.idea/
*.DotSettings.user

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ---------- dotnet (logic package + tests) ----------
dotnet/**/bin/
dotnet/**/obj/
dotnet/**/TestResults/

# ---------- Blender ----------
*.blend1
*.blend2

# ---------- Python ----------
__pycache__/
*.pyc

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
